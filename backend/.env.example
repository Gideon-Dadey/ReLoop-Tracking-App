PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/reloop?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development
API_VERSION=v1
PLASTIC_SAVED_PER_UNIT=0.05
CO2_SAVED_PER_UNIT=0.1
POINTS_PER_RETURN=10
