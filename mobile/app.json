{
  "expo": {
    "name": "ReLoop",
    "slug": "reloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/reloop.png",
    "scheme": "ReLoop",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/reloop.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.reloop.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/reloop.png",
        "backgroundImage": "./assets/reloop.png",
        "monochromeImage": "./assets/reloop.png"
      },
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#0A0F1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/reloop.png"
    },
    "plugins": [
      "expo-router",
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "1b7e77f9-f4e7-427c-86d2-a0e82a9a95f4"
      }
    },
    "owner": "g_ideon"
  }
}
