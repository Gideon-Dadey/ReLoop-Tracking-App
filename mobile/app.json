{
  "expo": {
    "name": "ReLoop",
    "slug": "reloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/reloop-star.png",
    "scheme": "ReLoop",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/reloop-star.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/reloop-star.png"
    },
    "android": {
      "package": "com.reloop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/reloop-star.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/reloop-star.png"
    },
    "plugins": [
      "expo-router",
      "expo-navigation-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/reloop-star.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./assets/reloop-star.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "1b7e77f9-f4e7-427c-86d2-a0e82a9a95f4"
      }
    },
    "owner": "g_ideon"
  }
}
